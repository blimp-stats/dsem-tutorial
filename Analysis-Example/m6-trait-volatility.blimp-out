MODEL INFORMATION:

  NUMBER OF PARAMETERS
    Outcome Models:         47
    Generated Parameters:   6
    Predictor Models:       0

  FACTORS
    Level-2:                b_0j b_1j b_2j g_0j g_1j g_2j l_j w_j

  DEFINED VARIABLES
    [1]  sleep_lag = sleep.lag - b_0j 
    [2]  pain_lag = pain.lag - g_0j 
    [3]  stress_c = stress - stress_mean 
    [4]  l_c = l_j - l_0 
    [5]  w_c = w_j - w_0 

  MODELS

   between:
    [1]  b_0j ~ Intercept@b_0 stress_c@b_4 l_c@b_7
    [2]  b_1j ~ Intercept@b_1 stress_c@b_5
    [3]  b_2j ~ Intercept@b_2 stress_c@b_6
    [4]  g_0j ~ Intercept@g_0 stress_c@g_4 w_c@g_7 (stress_c*w_c)@g_8
    [5]  g_1j ~ Intercept@g_1 stress_c@g_5
    [6]  g_2j ~ Intercept@g_2 stress_c@g_6
    [7]  l_j ~ Intercept@l_0 stress_c@l_1
    [8]  w_j ~ Intercept@w_0 stress_c@w_1
    [9]  stress ~ Intercept@stress_mean
   [10]  b_0j b_1j b_2j g_0j g_1j g_2j <-> b_0j b_1j b_2j g_0j g_1j g_2j 
   [11]  l_j <-> w_j

   within:
   [12]  pain ~ g_0j@1 (pain_lag)*g_1j@1 (sleep_lag)*g_2j@1
   [13]  var(pain) ~ w_j@1
   [14]  sleep ~ b_0j@1 (sleep_lag)*b_1j@1 (pain_lag)*b_2j@1 (sleep_lag*pain_lag)@b_3
   [15]  var(sleep) ~ l_j@1
   [16]  pain <-> sleep

  GENERATED PARAMETERS
    [1]  b_7_50 = b_7*log(1.5)
    [2]  g_7_50 = g_7*log(1.5)
    [3]  g_8_50 = g_8*log(1.5)
    [4]  w_sd = sqrt(w_j.totalvar)
    [5]  w_low = -w_sd
    [6]  w_high = w_sd


