MODEL INFORMATION:

  NUMBER OF PARAMETERS
    Outcome Models:         30
    Generated Parameters:   12
    Predictor Models:       0

  FACTORS
    Level-2:                b_0j b_1j b_2j g_0j g_1j g_2j

  DEFINED VARIABLES
    [1]  sleep_lag = sleep.lag - b_0j 
    [2]  pain_lag = pain.lag - g_0j 

  MODELS

   between:
    [1]  b_0j ~ Intercept@b_0
    [2]  b_1j ~ Intercept@b_1
    [3]  b_2j ~ Intercept@b_2
    [4]  g_0j ~ Intercept@g_0
    [5]  g_1j ~ Intercept@g_1
    [6]  g_2j ~ Intercept@g_2
    [7]  b_0j b_1j b_2j g_0j g_1j g_2j <-> b_0j b_1j b_2j g_0j g_1j g_2j 

   within:
    [8]  pain ~ g_0j@1 (pain_lag)*g_1j@1 (sleep_lag)*g_2j@1
    [9]  sleep ~ b_0j@1 (sleep_lag)*b_1j@1 (pain_lag)*b_2j@1
   [10]  pain <-> sleep

  GENERATED PARAMETERS
    [1]  b_1_sd = sqrt(b_1j.totalvar)
    [2]  b_1_low = b_1-b_1_sd
    [3]  b_1_high = b_1+b_1_sd
    [4]  b_2_sd = sqrt(b_2j.totalvar)
    [5]  b_2_low = b_2-b_2_sd
    [6]  b_2_high = b_2+b_2_sd
    [7]  g_1_sd = sqrt(g_1j.totalvar)
    [8]  g_1_low = g_1-g_1_sd
    [9]  g_1_high = g_1+g_1_sd
   [10]  g_2_sd = sqrt(g_2j.totalvar)
   [11]  g_2_low = g_2-g_2_sd
   [12]  g_2_high = g_2+g_2_sd


